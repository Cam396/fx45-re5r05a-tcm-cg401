<XDFFORMAT version="1.60">
<XDFHEADER>
  <flags>0x1</flags>
  <fileversion>3</fileversion>
  <deftitle>Infiniti FX45 RE5R05A TCM CG401 (MPC555) v3</deftitle>
  <description>Research-grade definition from code analysis + live data (reports 01-06). Calibration CRC-16/XMODEM at 0x6FFFC over 0x60090-0x6FFFB must be recomputed after any edit; TunerPro does not do it. Segment curves are raw {x0, y0, slope} records: y = y0 + slope*(x-x0)/16.</description>
  <author>FX45 owner (fx45bar project)</author>
  <BASEOFFSET offset="0" subtract="0" />
  <DEFAULTS datasizeinbits="8" sigdigits="2" outputtype="1" signed="0" lsbfirst="0" float="0" />
  <REGION type="0xFFFFFFFF" startaddress="0x0" size="0x70000" regionflags="0x0" name="Binary File" desc="448 kB MPC555 image" />
  <CATEGORY index="0x0" name="Gearbox" />
  <CATEGORY index="0x1" name="Line pressure" />
  <CATEGORY index="0x2" name="Lock-up" />
  <CATEGORY index="0x3" name="Sensors" />
  <CATEGORY index="0x4" name="Shift quality" />
  <CATEGORY index="0x5" name="Shift schedule" />
  <CATEGORY index="0x6" name="Torque reduction" />
</XDFHEADER>
